      "source": [
        "def pounds_to_kg(pounds):\n",
        "    kilograms = pounds * 0.453592\n",
        "    return kilograms"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"100 pounds =\", pounds_to_kg(100), \"kg\")\n",
        "print(\"150 pounds =\", pounds_to_kg(150), \"kg\")\n",
        "print(\"120 pounds =\", pounds_to_kg(120), \"kg\")"
      ],
